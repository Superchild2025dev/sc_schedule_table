rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // PERMISSION_POLICY_START
    function isOwner() {
      return signedIn()
        && request.auth.token.email in [
          "2025superchild@gmail.com"
        ];
    }

    function isDeveloper() {
      return signedIn()
        && request.auth.token.email in [
          "developer@scswim.local"
        ];
    }

    function isGagyeongDesk() {
      return signedIn()
        && request.auth.token.email in [
          "gagyeong.desk@scswim.local"
        ];
    }

    function isGagyeongTeacher() {
      return signedIn()
        && request.auth.token.email in [
          "gagyeong.son@scswim.local",
          "gagyeong.park@scswim.local",
          "gagyeong.lee1@scswim.local",
          "gagyeong.kimjy@scswim.local",
          "gagyeong.kimms@scswim.local",
          "gagyeong.yoo@scswim.local"
        ];
    }

    function isYongamDesk() {
      return signedIn()
        && request.auth.token.email in [
          "yongam.desk@scswim.local"
        ];
    }

    function isYongamTeacher() {
      return signedIn()
        && request.auth.token.email in [
          "yongam.lee1@scswim.local",
          "yongam.jung@scswim.local",
          "yongam.kimsh@scswim.local",
          "yongam.kimey@scswim.local",
          "yongam.kimjs@scswim.local",
          "yongam.lee2@scswim.local"
        ];
    }

    function isAnyTeacher() {
      return isGagyeongTeacher()
        || isYongamTeacher();
    }

    function canReadSchedule(branch) {
      return isOwner()
        || isDeveloper()
        || (branch == "gagyeong" && (isGagyeongDesk() || isAnyTeacher()))
        || (branch == "yongam" && (isYongamDesk() || isAnyTeacher()));
    }

    function canManageSchedule(branch) {
      return isOwner()
        || isDeveloper()
        || (branch == "gagyeong" && isGagyeongDesk())
        || (branch == "yongam" && isYongamDesk());
    }

    function isTeacherForBranch(branch) {
      return branch in ["gagyeong","yongam"]
        && isAnyTeacher();
    }

    function isTeacherWritableScheduleKey(docId) {
      return docId == "swim_mark"
        || docId == "swim_requests"
        || docId == "swim_attendance"
        || docId == "swim_att_guests"
        || docId == "swim_day_snapshot"
        || docId == "zz_swim_audit_index"
        || docId.matches("^swim_bt_attendance_.*$")
        || docId.matches("^swim_bt_att_guests_.*$")
        || docId.matches("^swim_bt_day_snapshot_.*$")
        || docId.matches("^zz_swim_day_snapshot__.*$")
        || docId.matches("^zz_swim_audit_entry__.*$");
    }

    function canTeacherWriteScheduleKey(branch, docId) {
      return isTeacherForBranch(branch)
        && isTeacherWritableScheduleKey(docId);
    }

    function canReadScheduleV2Runtime(documentId) {
      return documentId in ["operational","attendance","scheduleSync"];
    }

    function canReadScheduleV2GenerationCollection(collection) {
      return collection in ["tabs","people","enrollments","placements","teacherAssignments","reservations","waitlistEntries","classMarks","attendanceRecords","attendanceGuests","attendanceSnapshots","attendanceSnapshotStudents","attendanceSnapshotTeachers","disabledSlots","calendarClosures","schedulePeriods","scheduleSettings","teacherProfiles","tabFolders","archivedTabs","systemMetadata","retirementRecords","deskStudentRecords"];
    }

    function canReadScheduleV2Monitor() {
      return isOwner() || isDeveloper();
    }

    match /scheduleV2/{branch} {
      allow read: if canReadScheduleV2Monitor();
      allow write: if false;
    }

    match /scheduleV2/{branch}/alerts/{alertId} {
      allow read: if canReadScheduleV2Monitor();
      allow write: if false;
    }

    match /scheduleV2/{branch}/runtime/operationalRecovery {
      allow read, write: if false;
    }

    match /scheduleV2/{branch}/runtime/{documentId} {
      allow read: if canReadSchedule(branch)
        && canReadScheduleV2Runtime(documentId);
      allow write: if false;
    }

    match /scheduleV2/{branch}/generations/{generationId} {
      allow read: if canReadSchedule(branch);
      allow write: if false;
    }

    match /scheduleV2/{branch}/generations/{generationId}/{collection}/{recordId} {
      allow read: if canReadSchedule(branch)
        && canReadScheduleV2GenerationCollection(collection);
      allow write: if false;
    }

    match /scheduleV2/{branch}/operationalMutations/{document=**} {
      allow read, write: if false;
    }

    match /scheduleV2/{branch}/requestRecoveries/{document=**} {
      allow read, write: if false;
    }

    match /scheduleV2/{document=**} {
      allow read, write: if false;
    }
    // PERMISSION_POLICY_END

    function canManageReferrals(branch) {
      return isOwner()
        || isDeveloper()
        || (signedIn()
          && branch == "gagyeong"
          && request.auth.token.email == "gagyeong.desk@scswim.local")
        || (signedIn()
          && branch == "yongam"
          && request.auth.token.email == "yongam.desk@scswim.local");
    }

    match /scheduleStores/{branch}/{document=**} {
      allow read: if canReadSchedule(branch);
      allow write: if canManageSchedule(branch);
    }

    match /scheduleStores/{branch}/kv/{docId} {
      allow read: if canReadSchedule(branch);
      allow write: if canManageSchedule(branch)
        || canTeacherWriteScheduleKey(branch, docId);

      match /chunks/{chunkId} {
        allow read: if canReadSchedule(branch);
        allow write: if canManageSchedule(branch)
          || canTeacherWriteScheduleKey(branch, docId);
      }
    }

    match /referralPrograms/{branch}/{document=**} {
      allow read, write: if canManageReferrals(branch);
    }

    match /customerVoice/{branch}/tickets/{ticketId} {
      allow read, update: if canManageSchedule(branch);
      allow create, delete: if false;
    }

    match /customerVoiceRateLimits/{document=**} {
      allow read, write: if false;
    }

    match /publicRegularAvailability/{branch} {
      allow get: if branch in ["gagyeong", "yongam"];
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
